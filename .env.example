# Optional configuration for the lead-gen demo.
# Both scripts accept all of their config via CLI flags, so this file is
# entirely optional. Copy to `.env` and tweak if you want system-wide
# defaults. Neither script requires an API key.

# Run Playwright headless by default. Set to "false" to watch the browser.
HEADLESS=true

# Minimum / maximum seconds the polite-sleep helper will wait between
# requests. Bumping these up is safer on strict targets.
MIN_SLEEP=1.5
MAX_SLEEP=3.5
